@model List<ProductCatalog.Models.ProductModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Product Catalog</title>
    <style>
        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #1e293b;
        }

        .heading {
            margin-bottom: 28px;
        }

        .heading h1 {
                font-size: 34px;
                margin: 0 0 10px;
                color: #111827;
                letter-spacing: -1px;
        }

            .heading p {
                margin: 0;
                color: #64748b;
                font-size: 15px;
            }

        .table-card {
            background: white;
            border-radius: 14px;
            overflow-x: auto;
            border: 1px solid #e8edf5;
            box-shadow: 0 8px 30px rgba(15, 23, 42, 0.04);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            border: none;
        }

        th {
            background: #f8fafc;
            color: #64748b;
            padding: 19px 24px;
            text-align: left;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            border-bottom: 1px solid #e8edf5;
        }

        td {
            padding: 22px 24px;
            border-bottom: 1px solid #f0f3f8;
            font-size: 15px;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover {
            background: #f8fbff;
        }

        td {
            color: #64748b;
            font-weight: 600;
        }

        a {
            display: inline-block;
            background: #2563eb;
            color: white;
            padding: 10px 16px;
            text-decoration: none;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 600;
            transition: 0.2s;
            white-space: nowrap;
        }

            a:hover {
                background: #1d4ed8;
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.22);
                transform: translateY(-1px);
            }
    </style>
</head>
<body>

    <div class="page">
        <div class="heading">
            <h1>Product Catalog</h1>
            <p>Explore our collection and view product information.</p>
        </div>

        <div class="table-card">
            <table border="1">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>More Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.Name</td>
                            <td>@p.Price</td>
                            <td>
                                @Html.ActionLink("View Details →", "Details", "Product", new { id = p.Id }, null)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>